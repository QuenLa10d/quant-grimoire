\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{style}[2026/10/31 Quantitative Finance Style File]

% --- Language & Typography ---
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{csquotes} % Corrige le warning csquotes avec biblatex/babel
\RequirePackage[english]{babel}
\RequirePackage{geometry}
\RequirePackage{enumitem}
\RequirePackage{fontawesome5}
\geometry{margin=2.5cm}

% --- Professional Fonts ---
\RequirePackage{mathpazo} % Palatino font
\RequirePackage{microtype}

% --- Core Mathematics ---
\RequirePackage{amsmath, amssymb, amsfonts, mathtools, amsthm}
\RequirePackage{mathrsfs} % For filtrations \mathscr{F}_t
\RequirePackage{bbm}      % For indicator function \mathbbm{1}

% --- Bibliography ---
\RequirePackage[backend=biber, style=numeric, sorting=ynt]{biblatex}

% --- Colored Boxes Configuration ---
\RequirePackage[most]{tcolorbox}

\tcbset{
    quantbox/.style={
        enhanced,
        arc=3pt,
        boxrule=0.8pt,
        before skip=3em,
        after skip=3em,  
        fonttitle=\bfseries\sffamily,
        attach boxed title to top left={yshift=-2mm, xshift=5mm},
        top=4mm, bottom=2mm, left=2mm, right=2mm,
        drop shadow=black!10!white
    }
}

% 1. Definitions (Vert)
\newtcbtheorem[number within=chapter]{definition}{Definition}{
    quantbox,
    colback=green!3!white,
    colframe=green!45!black,
    coltitle=green!50!black,
    boxed title style={colback=green!10!white, size=small, boxrule=0pt}
}{def}

% 2. Theorems (Rouge)
\newtcbtheorem[use counter from=definition]{theorem}{Theorem}{
    quantbox,
    colback=red!3!white,
    colframe=red!60!black,
    coltitle=red!65!black,
    boxed title style={colback=red!10!white, size=small, boxrule=0pt}
}{thm}

% 3. Propositions (Orange)
\newtcbtheorem[use counter from=definition]{proposition}{Proposition}{
    quantbox,
    colback=orange!3!white,
    colframe=orange!60!black,
    coltitle=orange!60!black,
    boxed title style={colback=orange!10!white, size=small, boxrule=0pt}
}{prop}

% 4. Lemmas (Violet)
\newtcbtheorem[use counter from=definition]{lemma}{Lemma}{
    quantbox,
    colback=purple!3!white,
    colframe=purple!50!black,
    coltitle=purple!50!black,
    boxed title style={colback=purple!10!white, size=small, boxrule=0pt}
}{lem}

% 5. Examples (Bleu)
\newtcbtheorem[use counter from=definition]{example}{Example}{
    quantbox,
    colback=blue!3!white,
    colframe=blue!50!black,
    coltitle=blue!55!black,
    boxed title style={colback=blue!10!white, size=small, boxrule=0pt}
}{ex}

% --- Property / Proposition Box (Teal / Sapphire Blue) ---
\newtcbtheorem[number within=section]{property}{Property}{
    quantbox,
    colback=teal!4!white,
    colframe=teal!60!black,
    coltitle=white,
    fonttitle=\bfseries,
    after skip=1.2em
}{prop}

% Environnement Remark discret
\tcbset{
    remarkbox/.style={
        blanker,
        left=4mm,
        borderline west={2pt}{0pt}{gray!50!white}
    }
}

% --- Custom Proof Environment ---
\renewenvironment{proof}[1][Proof]{%
  \par\vspace{2mm}\noindent\textbf{#1.} \small%
}{%
  \hfill$\square$\par\vspace{4mm}%
}

% --- Grimoire Insight Box (Option Jaune Foncé / Ambre) ---
\newtcolorbox{insight}[1][]{
    quantbox,
    colback=yellow!10!white,
    colframe=orange!80!black,
    coltitle=white,
    title={{\color{yellow!80!white}\faLightbulb}~Grimoire Insight\ifx&#1&\else: #1\fi},
    boxed title style={colback=orange!80!black, size=small, boxrule=0pt}
}